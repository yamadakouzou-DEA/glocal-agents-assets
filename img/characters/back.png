<!DOCTYPE html>
<html lang="ja">
<!-- Build: 2026-04-10 Auto-deploy trigger -->
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=390, initial-scale=1.0">
<title>ご当地ひみつエージェント -GLOCAL AGENTS-</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=M+PLUS+Rounded+1c:wght@400;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="assets/css/design-system.css?v=20260410n">
<link rel="stylesheet" href="assets/css/layout.css?v=20260413g">
<link rel="stylesheet" href="assets/css/components.css?v=20260414j">
<link rel="stylesheet" href="assets/css/nav.css?v=20260410n">
<link rel="stylesheet" href="assets/css/loader.css?v=20260410n">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#6d28d9">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="ひみつエージェント">
</head>
<body>
<div class="app-scale-wrapper" id="appWrapper">

  <!-- ローディング画面 -->
  <div class="loader-overlay" id="appLoader">
    <div class="loader-logo">
      <div class="loader-logo-mark">🕵️</div>
      <div class="loader-logo-text">GLOCAL AGENTS</div>
    </div>
    <div class="loader-subtitle">ご当地ひみつエージェント</div>
    <div class="loader-spinner">
      <div class="loader-dot"></div>
      <div class="loader-dot"></div>
      <div class="loader-dot"></div>
    </div>
  </div>

  <!-- アプリコンテンツ -->
  <div class="app-scroll">

    <!-- STATUS BAR -->
    <div class="status-bar">
      <span class="time">9:41</span>
      <div class="icons">
        <span>●●●</span>
        <span>WiFi</span>
        <span>🔋</span>
      </div>
    </div>

    <!-- HEADER -->
    <div class="app-header">
      <div class="header-boss-clip"><img src="assets/img/front/boss.png" class="header-boss" alt=""></div>
      <div class="header-top">
        <div class="header-logo">
          <div class="logo-wrap">
            <img src="assets/img/rogojp.png" class="logo-img" alt="GLOCAL AGENTS">
          </div>
        </div>
        <div class="header-agent">
          <div class="agent-info">
            <div class="agent-name"><span class="header-lv-badge" id="headerLvBadge">LV01</span><span id="agentName">エージェント・ネコ</span></div>
            <div class="agent-id" id="agentId">#0042 · 函館結社</div>
          </div>
          <div class="agent-avatar" id="agentAvatar">🐱</div>
        </div>
      </div>
      <!-- XPセクション（次のレベルまで + レベラー） -->
      <div class="header-xp-section">
        <div class="header-xp-label">次のレベルまで <span id="headerXpNext"></span></div>
        <div class="header-xp-strip"><div class="header-xp-fill" id="headerXpFill" style="width:0%"></div></div>
      </div>
      <div class="points-box">
        <div class="points-left">
          <div class="points-label" data-i18n="header.points_label">累計ポイント</div>
          <div class="points-num" id="headerPtTotal">0 <span class="points-unit">pt</span></div>
        </div>
        <div class="points-today">
          <div class="points-today-up">今日の獲得</div>
          <span class="points-today-num" id="headerPtToday">+0 pt</span>
        </div>
      </div>
    </div>

    <!-- 結社タブ（削除済み — 結社ページに統合） -->

    <!-- 画面コンテンツ（SPA的に差し替え） -->
    <div class="app-body" id="appBody">
      <!-- screens/*.html がここに読み込まれる -->
    </div>

  </div><!-- /app-scroll -->

  <!-- ホーム画面インストールモーダル（PWA用） -->
  <div id="installModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2>📱 アプリをインストール</h2>
        <button class="modal-close" onclick="document.getElementById('installModal').style.display='none'">✕</button>
      </div>

      <!-- プラットフォーム別タブ -->
      <div class="modal-tabs">
        <button class="modal-tab active" onclick="switchInstallTab('pc')" data-platform="pc">
          💻 デスクトップ（PC用）
        </button>
        <button class="modal-tab" onclick="switchInstallTab('android')" data-platform="android">
          🤖 Android用
        </button>
        <button class="modal-tab" onclick="switchInstallTab('ios')" data-platform="ios">
          🍎 iPhone / iPad
        </button>
      </div>

      <!-- デスクトップ（PC） -->
      <div id="install-pc" class="modal-section active">
        <p class="modal-description">
          ブラウザのアドレスバーにインストールボタンが表示されます。
        </p>
        <div class="modal-steps">
          <div class="step">
            <div class="step-num">1️⃣</div>
            <div>アドレスバーの <strong>インストールアイコン</strong>（↓）をクリック</div>
          </div>
          <div class="step">
            <div class="step-num">2️⃣</div>
            <div><strong>インストール</strong> をクリック</div>
          </div>
          <div class="step">
            <div class="step-num">3️⃣</div>
            <div>アプリがデスクトップに追加されます</div>
          </div>
        </div>
        <div class="modal-buttons">
          <button class="btn btn-primary" onclick="window._installAppPC()">
            💻 PCにインストール
          </button>
        </div>
      </div>

      <!-- Android -->
      <div id="install-android" class="modal-section">
        <p class="modal-description">
          Chrome でホーム画面に追加してアプリをインストール
        </p>
        <div class="modal-steps">
          <div class="step">
            <div class="step-num">1️⃣</div>
            <div>Chrome メニュー（⋮）をタップ</div>
          </div>
          <div class="step">
            <div class="step-num">2️⃣</div>
            <div><strong>「アプリをインストール」</strong> または <strong>「ホーム画面に追加」</strong>をタップ</div>
          </div>
          <div class="step">
            <div class="step-num">3️⃣</div>
            <div><strong>「追加」</strong> をタップ</div>
          </div>
          <div class="step">
            <div class="step-num">4️⃣</div>
            <div>ホーム画面に📱アイコンが表示されます</div>
          </div>
        </div>
        <div class="modal-buttons">
          <button class="btn btn-primary" onclick="window._installAppAndroid()">
            🤖 Androidにインストール
          </button>
        </div>
      </div>

      <!-- iOS / iPad -->
      <div id="install-ios" class="modal-section">
        <p class="modal-description">
          iOS では Safari から手動でホーム画面に追加します
        </p>
        <div class="modal-steps">
          <div class="step">
            <div class="step-num">1️⃣</div>
            <div>Safari でこのページを開く</div>
          </div>
          <div class="step">
            <div class="step-num">2️⃣</div>
            <div>下部の <strong>共有ボタン</strong>（□に↑）をタップ</div>
          </div>
          <div class="step">
            <div class="step-num">3️⃣</div>
            <div><strong>「ホーム画面に追加」</strong> をタップ</div>
          </div>
          <div class="step">
            <div class="step-num">4️⃣</div>
            <div>名前を確認して <strong>「追加」</strong> をタップ</div>
          </div>
        </div>
        <div class="modal-buttons">
          <button class="btn btn-primary" onclick="window._installAppIOS()">
            🍎 iOSにインストール
          </button>
        </div>
        <div class="modal-note" style="background:#fef3c7; border-left:4px solid #f97316;">
          ✅ ホーム画面に追加されたアプリから開くと、すべての機能が使えます。
        </div>
      </div>
    </div>
  </div>

  <!-- 通知登録モーダル（Kamuiverse パターン） -->
  <div id="notificationModal" class="modal-overlay" style="display:none;">
    <div class="modal-content">
      <div class="modal-header">
        <h2>📢プッシュ通知を登録</h2>
        <button class="modal-close" onclick="document.getElementById('notificationModal').style.display='none'">✕</button>
      </div>

      <!-- プラットフォーム別タブ -->
      <div class="modal-tabs">
        <button class="modal-tab active" onclick="switchNotificationTab('pc')" data-platform="pc">
          💻 デスクトップ（PC用）
        </button>
        <button class="modal-tab" onclick="switchNotificationTab('android')" data-platform="android">
          🤖 Android用
        </button>
        <button class="modal-tab" onclick="switchNotificationTab('ios')" data-platform="ios">
          🍎 iPhone / iPad
        </button>
      </div>

      <!-- デスクトップ（PC） -->
      <div id="notif-pc" class="modal-section active">
        <p class="modal-description">
          ブラウザの通知機能でミッション更新やお知らせを受け取れます。
        </p>
        <div class="modal-buttons">
          <button class="btn btn-primary" onclick="window._enableNotificationPC()">
            💻 PCで通知を有効にする
          </button>
        </div>
        <div class="modal-note">
          <strong>ボタンが無効な場合:</strong>
          <ol>
            <li>ブラウザのアドレスバーの鍵アイコンをクリック</li>
            <li>通知の設定を確認</li>
          </ol>
        </div>
      </div>

      <!-- Android -->
      <div id="notif-android" class="modal-section">
        <p class="modal-description">
          Chrome でホーム画面に追加して、通知を受け取りましょう。
        </p>
        <div class="modal-buttons">
          <button class="btn btn-primary" onclick="window._enableNotificationAndroid()">
            🤖 Androidで通知を有効にする
          </button>
        </div>
        <div class="modal-note">
          <strong>ボタンが無効な場合:</strong>
          <ol>
            <li>Chrome メニュー（⋮） をタップ</li>
            <li>「アプリをインストール」をタップ</li>
            <li>ホーム画面に追加後、通知を有効化</li>
          </ol>
        </div>
      </div>

      <!-- iOS / iPad -->
      <div id="notif-ios" class="modal-section">
        <p class="modal-description">
          iOS ではブラウザから直接インストールできないため、手動で追加します。<br>
          <strong style="color:#f97316;">ホーム画面に追加後、通知が有効になります。</strong>
        </p>
        <div class="modal-steps">
          <div class="step">
            <div class="step-num">1️⃣</div>
            <div>Safari で このページを開く</div>
          </div>
          <div class="step">
            <div class="step-num">2️⃣</div>
            <div>下部の <strong>共有ボタン</strong>（□に↑）をタップ</div>
          </div>
          <div class="step">
            <div class="step-num">3️⃣</div>
            <div><strong>ホーム画面に追加</strong> をタップ</div>
          </div>
          <div class="step">
            <div class="step-num">4️⃣</div>
            <div>名前を確認して <strong>追加</strong> をタップ</div>
          </div>
        </div>
        <div class="modal-note" style="background:#fef3c7; border-left:4px solid #f97316;">
          ✅ ホーム画面に追加されたアプリから開くと、通知が機能します。
        </div>
      </div>
    </div>
  </div>

  <!-- ボトムナビ -->
  <div class="app-nav" id="appNav">
    <div class="nav-item active">
      <div class="nav-ico">🏠</div>
      <div data-i18n="nav.home">ホーム</div>
      <div class="nav-dot"></div>
    </div>
    <div class="nav-item">
      <div class="nav-ico">🗺</div>
      <div data-i18n="nav.societies">結社</div>
      <div class="nav-badge" id="socQuizBadge" style="display:none;">①</div>
    </div>
    <div class="nav-item">
      <div class="nav-ico">🎯</div>
      <div data-i18n="nav.missions">ミッション</div>
      <div class="nav-badge">3</div>
    </div>
    <div class="nav-item">
      <div class="nav-ico">💎</div>
      <div data-i18n="nav.points">ポイント</div>
    </div>
    <div class="nav-item">
      <div class="nav-ico">👤</div>
      <div data-i18n="nav.agent">エージェント</div>
    </div>
  </div>

  <!-- ①フロント画面（未ログイン時） -->
  <div class="front-overlay" id="frontModal" style="display:none;">
    <!-- 言語トグル -->
    <button class="lang-toggle-btn" onclick="setLang(getLang()==='ja'?'en':'ja')" style="position:absolute;top:135px;right:14px;background:rgba(255,255,255,0.35);color:#fff;border:1px solid rgba(255,255,255,0.8);border-radius:20px;padding:5px 12px;font-size:12px;font-weight:700;cursor:pointer;z-index:10;backdrop-filter:blur(4px);text-shadow:0 1px 3px rgba(0,0,0,0.5);">🌐 EN</button>
    <!-- ロゴ + BOSSシルエット（ボスをロゴ後ろに重ねる） -->
    <div class="fp-logo-wrap">
      <img src="assets/img/rogojp.png" class="fp-logo" alt="GLOCAL AGENTS">
      <img src="assets/img/front/boss.png" class="fp-boss" alt="">
    </div>
    <!-- タグライン -->
    <p class="fp-tagline" data-i18n="app.tagline">ポイントゲットして、世界を救おう！</p>
    <!-- 地球（固定） + のぞきキャラ（軌道周回） -->
    <div class="fp-world">
      <img src="assets/img/front/earth.png" class="fp-earth" alt="">
      <div class="fp-orbit fp-orbit1"><img src="assets/img/front/kabe1.png" class="fp-kabe" alt=""></div>
      <div class="fp-orbit fp-orbit2"><img src="assets/img/front/kabe2.png" class="fp-kabe" alt=""></div>
      <div class="fp-orbit fp-orbit3"><img src="assets/img/front/kabe3.png" class="fp-kabe" alt=""></div>
    </div>
    <!-- メインキャラ（スーツ組） -->
    <div class="fp-charas">
      <img src="assets/img/front/kitsune.png" class="fp-chara fp-chara-l" alt="">
      <img src="assets/img/front/neko_main.png" class="fp-chara fp-chara-r" alt="">
    </div>
    <!-- ボタン -->
    <div class="fp-btns">
      <button class="front-btn fp-btn-start" id="frontStart" data-i18n="front.btn_start">はじめる</button>
    </div>
  </div>

  <!-- ②バー演出オンボーディング（新規のみ） -->
  <div class="bar-overlay" id="barModal" style="display:none;">
    <div class="bar-inner">

      <!-- Step1: 合言葉 -->
      <div class="bar-step" id="barStep1">
        <div class="bar-scene-label" data-i18n="onboarding.scene_label">— とある街の片隅、秘密のバー —</div>
        <div class="bar-master-row">
          <div class="bar-avatar">🧔</div>
          <div class="bar-speech" data-i18n="onboarding.master_step1">…いらっしゃい。<br>ここは普通のバーじゃない。<br><strong>合言葉は？</strong></div>
        </div>
        <div class="bar-action">
          <input type="text" id="barPassphrase" class="bar-input" placeholder="合言葉を入力..." data-i18n-placeholder="onboarding.passphrase_placeholder" autocomplete="off">
          <div class="bar-hint" id="barPassHint" style="display:none;" data-i18n="onboarding.passphrase_hint">ヒント: SNSで拡散中のあの言葉を探してみて 👀</div>
          <button class="bar-btn" id="barPassBtn" data-i18n="onboarding.btn_open_door">扉を開く 🚪</button>
        </div>
      </div>

      <!-- Step2: 変なメニュー選択 -->
      <div class="bar-step" id="barStep2" style="display:none;">
        <div class="bar-master-row">
          <div class="bar-avatar">🧔</div>
          <div class="bar-speech" data-i18n="onboarding.master_step2">よく来た。<br>今夜は<strong>何にする？</strong></div>
        </div>
        <div class="bar-menu-list" id="barMenuList">
          <div class="bar-menu-item" data-idx="0"><span class="bar-menu-ico">☕</span><span data-i18n="onboarding.menu_item_0">記憶消去剤入りコーヒー</span></div>
          <div class="bar-menu-item" data-idx="1"><span class="bar-menu-ico">🎂</span><span data-i18n="onboarding.menu_item_1">見えないケーキ</span></div>
          <div class="bar-menu-item" data-idx="2"><span class="bar-menu-ico">🍜</span><span data-i18n="onboarding.menu_item_2">世界の真実スープ</span></div>
          <div class="bar-menu-item" data-idx="3"><span class="bar-menu-ico">🍵</span><span data-i18n="onboarding.menu_item_3">影の紅茶</span></div>
          <div class="bar-menu-item" data-idx="4"><span class="bar-menu-ico">🥪</span><span data-i18n="onboarding.menu_item_4">秘密のサンドイッチ</span></div>
        </div>
      </div>

      <!-- Step3: コードネームルーレット -->
      <div class="bar-step" id="barStep3" style="display:none;">
        <div class="bar-master-row">
          <div class="bar-avatar">🧔</div>
          <div class="bar-speech" data-i18n="onboarding.master_step3">ふむ…では<br>君のコードネームは…</div>
        </div>
        <div class="bar-roulette-wrap">
          <div class="bar-roulette-label">CODE NAME</div>
          <div class="bar-roulette" id="barCodeRoulette">---</div>
        </div>
        <div class="bar-action bar-action-row" id="barCodeActions" style="display:none;">
          <button class="bar-btn bar-btn-ghost" id="barCodeRetry" data-i18n="onboarding.btn_retry">やり直す</button>
          <button class="bar-btn" id="barCodeConfirm" data-i18n="onboarding.btn_confirm_code">これにする！</button>
        </div>
      </div>

      <!-- Step4: ようこそ -->
      <div class="bar-step" id="barStep4" style="display:none;">
        <div class="bar-welcome">
          <div class="bar-welcome-icon">🕵️</div>
          <div class="bar-welcome-title" data-i18n="onboarding.welcome_title">ようこそ<br>ひみつコミュニティへ</div>
          <div class="bar-welcome-code" id="barWelcomeCode"></div>
        </div>
        <div class="bar-master-row">
          <div class="bar-avatar">🧔</div>
          <div class="bar-speech" data-i18n="onboarding.master_step4">スマホに<br>必要なことを送ったよ 📱</div>
        </div>
        <button class="bar-btn" id="barWelcomeNext" data-i18n="onboarding.btn_next">次へ →</button>
      </div>

      <!-- Step5: 結社ルーレット -->
      <div class="bar-step" id="barStep5" style="display:none;">
        <div class="bar-master-row">
          <div class="bar-avatar">🧔</div>
          <div class="bar-speech" data-i18n="onboarding.master_step5">じゃあ活動する<br><strong>コミュニティはここだ</strong></div>
        </div>
        <div class="bar-roulette-wrap">
          <div class="bar-roulette-label">SECRET SOCIETY</div>
          <div class="bar-roulette bar-roulette-soc" id="barSocRoulette">---</div>
        </div>
        <div class="bar-action bar-action-row" id="barSocActions" style="display:none;">
          <button class="bar-btn bar-btn-ghost" id="barSocRetry" data-i18n="onboarding.btn_retry_society">もう一度</button>
          <button class="bar-btn" id="barSocConfirm" data-i18n="onboarding.btn_confirm_society">ここにする！</button>
        </div>
      </div>

      <!-- Step6: 合言葉（パスワード）設定 -->
      <div class="bar-step" id="barStep6" style="display:none;">
        <div class="bar-master-row">
          <div class="bar-avatar">🧔</div>
          <div class="bar-speech bar-speech-sm" id="barMasterFinal" data-i18n="onboarding.master_step6">さぁ、今日から君はエージェントだ。<br>「私との合言葉」を決めてくれ</div>
        </div>
        <div class="bar-action">
          <input type="password" id="barMyPass" class="bar-input" placeholder="合言葉（パスワード）" data-i18n-placeholder="onboarding.password_placeholder" autocomplete="new-password">
          <input type="password" id="barMyPassConfirm" class="bar-input" placeholder="もう一度入力" data-i18n-placeholder="onboarding.password_confirm_placeholder" autocomplete="new-password">
          <div class="bar-hint" id="barMyPassError" style="display:none;"></div>
          <button class="bar-btn" id="barMyPassBtn" data-i18n="onboarding.btn_start_activity">決定！活動開始 🚀</button>
        </div>
      </div>

    </div><!-- /bar-inner -->
  </div>

  <!-- ③ログインモーダル：showLoginModal()で動的生成 -->

  <!-- 結社詳細フルスクリーン -->
  <div id="socDetailScreen" style="display:none;position:absolute;top:0;left:0;right:0;bottom:0;z-index:150;background:#081024;overflow-y:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;">
    <div id="socDetailContent"></div>
  </div>

</div><!-- /app-scale-wrapper -->

<script>
// 🔔 位置調整コントロール初期化（ホットスポット版は home.html で管理）
// → 古いコントロールコードは削除（bell は hotspot hs-ico で実装済み）
</script>

<script>
// Load scripts with version query
(function() {
  var version = '20260414q';
  var appScript = document.createElement('script');
  appScript.src = 'assets/js/app.js?v=' + version;
  document.body.appendChild(appScript);

  var regScript = document.createElement('script');
  regScript.src = 'assets/js/registration.js?v=' + version;
  document.body.appendChild(regScript);
})();
</script>

<!-- ─── PWA: Service Worker + Push通知（iOS/Android/PC対応） ─── -->
<script>
(function() {
  'use strict';
  var VAPID_PUBLIC = 'BKZB6j4cnE9dFDz0Kg_Azla1Az1GFY9ckgTgFMHx-K-ZBy5jXgRAh-I3w-078NbVIRRHdycKiNHDA4HE1Jzou9c';
  var API_BASE = '/api/push';
  var ua = navigator.userAgent;

  // ── プラットフォーム判定 ──────────────────────────────────
  var isIOS     = /iP(hone|ad|od)/.test(ua);
  var isAndroid = /Android/.test(ua);
  var isInApp   = /Line|FBAN|FBAV|Instagram|Twitter|MicroMessenger/.test(ua); // LINEなどアプリ内ブラウザ
  var isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

  // ── utils ────────────────────────────────────────────────
  function urlB64ToU8(b64) {
    var pad = '='.repeat((4 - b64.length % 4) % 4);
    var raw = atob((b64 + pad).replace(/-/g, '+').replace(/_/g, '/'));
    return Uint8Array.from(Array.from(raw).map(function(c){ return c.charCodeAt(0); }));
  }
  function arrayBufferToBase64(buf) {
    var bytes = new Uint8Array(buf), bin = '';
    for (var i = 0; i < bytes.byteLength; i++) bin += String.fromCharCode(bytes[i]);
    return btoa(bin);
  }

  // ── ベルUI更新 ────────────────────────────────────────────
  function updateBell(state) {
    var bell = document.getElementById('notifBell');
    if (!bell) return;
    if (state === 'granted') {
      bell.textContent = '🔔'; bell.style.opacity = '1'; bell.title = '通知ON';
      _markInstalledShowBell();  // 通知許可済み → ベル表示
    } else if (state === 'denied') {
      bell.textContent = '🔕'; bell.style.opacity = '0.3'; bell.title = '通知ブロック中（ブラウザ設定から変更）';
    } else {
      bell.textContent = '🔕'; bell.style.opacity = '0.55'; bell.title = '通知を設定';
    }
  }

  // ── iOS「ホーム画面に追加」モーダル ──────────────────────
  function showIOSInstallModal() {
    if (document.getElementById('pwaIOSModal')) return;
    var m = document.createElement('div');
    m.id = 'pwaIOSModal';
    m.style.cssText = 'position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.7);display:flex;align-items:flex-end;justify-content:center;';
    m.innerHTML = [
      '<div style="background:#1e1b4b;border-radius:20px 20px 0 0;padding:24px 20px 40px;width:100%;max-width:390px;color:#e2e8f0;font-family:sans-serif;">',
        '<div style="text-align:center;font-size:22px;margin-bottom:8px;">📲 通知を受け取るには</div>',
        '<div style="font-size:13px;color:#94a3b8;text-align:center;margin-bottom:20px;">iOSはまずホーム画面に追加が必要です（iOS 16.4以降）</div>',
        '<div style="background:rgba(255,255,255,0.05);border-radius:12px;padding:16px;font-size:14px;line-height:2;">',
          '<div>① SafariでこのページのURLを開く</div>',
          '<div>② 下部の <strong>共有ボタン</strong>（□に↑）をタップ</div>',
          '<div>③ <strong>「ホーム画面に追加」</strong> を選択</div>',
          '<div>④ ホーム画面のアイコンから起動 → 🔔 をタップ</div>',
        '</div>',
        '<button onclick="document.getElementById(\'pwaIOSModal\').remove()" ',
          'style="margin-top:20px;width:100%;padding:14px;border:none;border-radius:12px;background:#6d28d9;color:#fff;font-size:15px;font-weight:700;cursor:pointer;">',
          '閉じる',
        '</button>',
      '</div>'
    ].join('');
    document.body.appendChild(m);
    m.addEventListener('click', function(e){ if(e.target === m) m.remove(); });
  }

  // ── アプリ内ブラウザ警告 ──────────────────────────────────
  function showInAppBrowserWarning() {
    if (document.getElementById('pwaInAppWarn')) return;
    var w = document.createElement('div');
    w.id = 'pwaInAppWarn';
    w.style.cssText = 'position:fixed;top:0;left:0;right:0;z-index:9999;background:#92400e;color:#fef3c7;padding:10px 16px;font-size:13px;text-align:center;';
    w.innerHTML = '⚠️ このブラウザでは通知登録できません。<strong>SafariまたはChromeで開いて</strong>ください。<button onclick="this.parentNode.remove()" style="margin-left:12px;background:none;border:1px solid #fef3c7;color:#fef3c7;border-radius:6px;padding:2px 8px;cursor:pointer;">✕</button>';
    document.body.prepend(w);
  }

  // ── Push購読（Android・PC用） ─────────────────────────────
  window.doSubscribe = async function doSubscribe() {
    if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
      alert('このブラウザはプッシュ通知に対応していません');
      return;
    }
    var perm = 'Notification' in window ? Notification.permission : 'default';
    if (perm === 'denied') { alert('ブラウザの設定から通知をオンにしてください'); return; }
    if (perm !== 'granted') perm = await Notification.requestPermission();
    if (perm !== 'granted') return;
    try {
      var reg = await navigator.serviceWorker.ready;
      var sub = await reg.pushManager.getSubscription();
      if (!sub) {
        sub = await reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: urlB64ToU8(VAPID_PUBLIC) });
      }
      var user = {};
      try { user = JSON.parse(localStorage.getItem('currentUser') || '{}'); } catch(_) {}
      var payload = {
        action: 'subscribe',
        subscription: {
          endpoint: sub.endpoint,
          keys: {
            p256dh: arrayBufferToBase64(sub.getKey('p256dh')),
            auth:   arrayBufferToBase64(sub.getKey('auth'))
          }
        },
        userId: user.id || null
      };
      await fetch(API_BASE, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload) });
      updateBell('granted');
    } catch(e) {
      console.warn('[Push] subscribe failed:', e);
    }
  }

  // ── モーダルのタブ切り替え（notificationModal スコープ）──────
  window.switchNotificationTab = function(platform) {
    var modal = document.getElementById('notificationModal');
    if (!modal) return;
    modal.querySelectorAll('.modal-tab').forEach(function(tab) {
      tab.classList.remove('active');
    });
    var activeTab = modal.querySelector('.modal-tab[data-platform="' + platform + '"]');
    if (activeTab) activeTab.classList.add('active');
    modal.querySelectorAll('.modal-section').forEach(function(sec) {
      sec.classList.remove('active');
    });
    var sec = document.getElementById('notif-' + platform);
    if (sec) sec.classList.add('active');
  };

  // ── PC: 通知を有効にする ──────────────────────────────────
  window._enableNotificationPC = function() {
    console.log('[PC Button] _enableNotificationPC called');
    console.log('[PC Button] doSubscribe function type:', typeof doSubscribe);
    var subscribePromise = doSubscribe();
    console.log('[PC Button] doSubscribe returned:', subscribePromise);
    subscribePromise.then(function() {
      console.log('[PC Button] doSubscribe completed successfully');
      var modal = document.getElementById('notificationModal');
      if (modal) {
        modal.style.display = 'none';
        console.log('[PC Button] Modal closed');
      }
    }).catch(function(e) {
      console.error('[PC Button] Error:', e);
    });
  };

  // ── Android: 通知を有効にする ────────────────────────────
  window._enableNotificationAndroid = function() {
    // beforeinstallprompt イベントを優先（インストールプロンプト）
    if (window._bipEvent) {
      window._bipEvent.prompt();
      window._bipEvent.userChoice.then(function(choiceResult) {
        if (choiceResult.outcome === 'accepted') {
          // インストールされた後、通知登録
          setTimeout(function() { doSubscribe(); }, 1000);
        }
      });
      window._bipEvent = null;
    } else {
      // beforeinstallprompt がない場合は直接通知登録
      doSubscribe().then(function() {
        var modal = document.getElementById('notificationModal');
        if (modal) modal.style.display = 'none';
      }).catch(function(e) {
        console.error('[Notification Android] Error:', e);
      });
    }
  };

  // ── ベルボタンクリック（プラットフォーム分岐） ────────────
  // 注: requestPushPermission() は app.js で定義済み（モーダル表示版）
  // index.html のバージョンはコメントアウト
  /*
  window.requestPushPermission = function() {
    if (isInApp)  { showInAppBrowserWarning(); return; }
    if (isIOS && !isStandalone) { showIOSInstallModal(); return; }
    doSubscribe();
  };
  */

  // ── Android: beforeinstallprompt キャプチャ ───────────────
  window._bipEvent = null;
  window.addEventListener('beforeinstallprompt', function(e) {
    e.preventDefault();
    window._bipEvent = e;
  });
  window.triggerAndroidInstall = function() {
    if (window._bipEvent) { window._bipEvent.prompt(); window._bipEvent = null; }
  };

  // ── インストール済みフラグ＆ベル表示 ─────────────────────
  function _markInstalledShowBell() {
    localStorage.setItem('pwa_installed', '1');
    window._showBellIfInstalled && window._showBellIfInstalled();
  }

  // ── ベル表示制御（home.html がロードされた後に呼ぶ）────────
  window._showBellIfInstalled = function() {
    var bellHs = document.getElementById('notifBellHs');
    if (!bellHs) return;
    var installed = localStorage.getItem('pwa_installed') === '1' || isStandalone;
    var notifGranted = ('Notification' in window) && Notification.permission === 'granted';
    bellHs.style.display = (installed || notifGranted) ? '' : 'none';
  };

  // ── タブ切替（installModal スコープ）───────────────────────
  window.switchInstallTab = function(platform) {
    var modal = document.getElementById('installModal');
    if (!modal) return;
    modal.querySelectorAll('.modal-tab').forEach(function(t){ t.classList.remove('active'); });
    modal.querySelectorAll('.modal-section').forEach(function(s){ s.classList.remove('active'); });
    var tab = modal.querySelector('.modal-tab[data-platform="'+platform+'"]');
    var sec = document.getElementById('install-'+platform);
    if (tab) tab.classList.add('active');
    if (sec) sec.classList.add('active');
  };

  // ── インストールモーダルを開く ───────────────────────────
  window.requestInstallApp = function() {
    var modal = document.getElementById('installModal');
    if (!modal) return;
    if (isIOS) {
      window.switchInstallTab('ios');
    } else if (isAndroid) {
      window.switchInstallTab('android');
    } else {
      window.switchInstallTab('pc');
    }
    modal.style.display = 'flex';
  };

  // ── PC: インストール ────────────────────────────────────
  window._installAppPC = function() {
    if (window._bipEvent) {
      window._bipEvent.prompt();
      window._bipEvent.userChoice.then(function(r) {
        window._bipEvent = null;
        if (r.outcome === 'accepted') {
          var m = document.getElementById('installModal');
          if (m) m.style.display = 'none';
          _markInstalledShowBell();
        }
      });
    } else {
      alert('アドレスバー右端のインストールアイコン（⊕）をクリックするか、既にインストール済みです。');
    }
  };

  // ── Android: インストール ───────────────────────────────
  window._installAppAndroid = function() {
    if (window._bipEvent) {
      window._bipEvent.prompt();
      window._bipEvent.userChoice.then(function(r) {
        window._bipEvent = null;
        if (r.outcome === 'accepted') {
          var m = document.getElementById('installModal');
          if (m) m.style.display = 'none';
          _markInstalledShowBell();
        }
      });
    } else {
      alert('Chrome メニュー（⋮）→「アプリをインストール」または「ホーム画面に追加」からインストールしてください。');
      _markInstalledShowBell(); // 手動インストール後にベルを表示
    }
  };

  // ── iOS: インストール手順を表示 ─────────────────────────
  window._installAppIOS = function() {
    var m = document.getElementById('installModal');
    if (m) m.style.display = 'none';
    showIOSInstallModal();
    _markInstalledShowBell(); // iOS は手動なので説明表示後にベルを見せる
  };

  // ── ベルタップ: 通知許可（プラットフォーム分岐）────────
  window.requestPushPermission = function() {
    if (isInApp) { showInAppBrowserWarning(); return; }
    if (isIOS && !isStandalone) { showIOSInstallModal(); return; }
    var modal = document.getElementById('notificationModal');
    if (modal) modal.style.display = 'flex';
  };

  // ── Service Worker 登録 ───────────────────────────────────
  // ★ 修正: OAuth callback 中は Service Worker 登録をスキップ
  // ★ ポップアップ内でも登録をスキップ（窓口ウィンドウでのみ登録）
  var shouldRegisterSW = function() {
    // OAuth callback URL中かどうか判定
    var isOAuthCallback = location.search.indexOf('oauth_provider=') !== -1 ||
                         location.search.indexOf('google_error=') !== -1 ||
                         location.search.indexOf('line_error=') !== -1;
    // ポップアップウィンドウかどうか判定（複数の方法で確認）
    var isPopup = (window.opener !== null && window.opener !== undefined) &&
                  !window.opener.closed;

    console.log('[SW] Register check - isOAuthCallback:', isOAuthCallback, 'isPopup:', isPopup, 'opener:', typeof window.opener);

    // OAuth callback 中またはポップアップの場合、登録をスキップ
    return !isOAuthCallback && !isPopup;
  };

  if ('serviceWorker' in navigator && shouldRegisterSW()) {
    window.addEventListener('load', function() {
      navigator.serviceWorker.register('/sw.js').then(function(reg) {
        if ('Notification' in window) {
          updateBell(Notification.permission);
          if (Notification.permission === 'granted') {
            reg.pushManager.getSubscription().then(function(sub) {
              if (sub) updateBell('granted');
            });
          }
        }
      }).catch(function(e) { console.warn('[SW]', e); });
    });
  }
})();
</script>

<!-- 📷 写真ミッションモーダル -->
<div id="photoMissionOverlay" class="mission-panel-overlay">
  <div class="mission-panel">
    <div id="photoMissionContent"></div>
  </div>
</div>

<!-- ★ Core App Logic ★ (dynamically loaded above) ★ -->

</body>
</html>
